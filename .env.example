# ==============================================================================
# DietFit Environment Variables Template
# Copy this file to .env and replace the placeholder values with your actual keys.
# NEVER commit the actual .env file or credentials to source control.
# ==============================================================================

# Google Gemini API Key (for food vision analysis and nutritional coaching)
# Get key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY="YOUR_GOOGLE_GEMINI_API_KEY"

# Groq API Key (for fast LLM inferences if Groq models are configured)
# Get key from: https://console.groq.com/keys
GROQ_API_KEY="YOUR_GROQ_API_KEY"

# Tavily API Key (for web recipe retrieval and web search)
# Get key from: https://tavily.com/
TAVILY_API_KEY="YOUR_TAVILY_API_KEY"

# USDA FoodData Central API Key (for official nutritional database queries)
# Get key from: https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY="YOUR_USDA_API_KEY"

# SMTP Email Relay Configuration (for Out-of-Band OTP email verification & password reset)
# For Gmail, create a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-16-char-app-password"
SMTP_FROM_NAME="DietFit Security Matrix"

