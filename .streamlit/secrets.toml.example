# Streamlit Native Google OAuth Authentication Secrets Configuration
# Replace client_id and client_secret with your Google Cloud Console OAuth 2.0 Credentials.
# Learn more: https://docs.streamlit.io/develop/api-reference/user/st.login

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "dietfit_secure_session_cookie_secret_key_32_bytes_min"

[auth.google]
client_id = "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
client_secret = "YOUR_GOOGLE_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
